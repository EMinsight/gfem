<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- gfem code panel, light (the syn-* tokens of docs/_static/gfem.css). Keywords in the signal red,
     strings in trace green, numbers in muted blue, comments italic, operators muted. -->
<plist version="1.0">
<dict>
  <key>name</key><string>gfem light</string>
  <key>settings</key>
  <array>
    <dict><key>settings</key><dict>
      <key>foreground</key><string>#262626</string>
      <key>background</key><string>#fafafa</string>
    </dict></dict>
    <dict><key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#6b6b67</string><key>fontStyle</key><string>italic</string></dict></dict>
    <dict><key>scope</key><string>keyword, storage, storage.type, storage.modifier, keyword.control, keyword.other, meta.decorator, entity.name.function.decorator, support.type.exception, constant.character.escape</string>
      <key>settings</key><dict><key>foreground</key><string>#b5262f</string></dict></dict>
    <dict><key>scope</key><string>keyword.operator, keyword.operator.logical, punctuation, meta.brace, punctuation.separator, punctuation.section</string>
      <key>settings</key><dict><key>foreground</key><string>#6b6b6b</string></dict></dict>
    <dict><key>scope</key><string>string, string.quoted, punctuation.definition.string</string>
      <key>settings</key><dict><key>foreground</key><string>#1a7354</string></dict></dict>
    <dict><key>scope</key><string>constant.numeric, constant.language, support.constant</string>
      <key>settings</key><dict><key>foreground</key><string>#1d5a94</string></dict></dict>
    <dict><key>scope</key><string>entity.name.function, entity.name.class, entity.name.type</string>
      <key>settings</key><dict><key>foreground</key><string>#262626</string><key>fontStyle</key><string>bold</string></dict></dict>
    <dict><key>scope</key><string>variable.parameter, variable.language</string>
      <key>settings</key><dict><key>foreground</key><string>#3d3d3d</string></dict></dict>
  </array>
</dict>
</plist>
